DATABASE_URL=postgresql://postgres:***@localhost:5432/mergepay
# Prisma / Postgres connection resilience. These are appended to DATABASE_URL as
# query parameters by src/db.ts, so a slow or saturated database fails fast
# instead of hanging request workers.
DATABASE_CONNECT_TIMEOUT_SECONDS=10   # socket-establish timeout to Postgres
DATABASE_POOL_TIMEOUT_SECONDS=10     # max wait for a free pooled connection
DATABASE_CONNECTION_LIMIT=5          # max pooled connections per instance
DATABASE_QUERY_TIMEOUT_MS=10000      # per-query timeout (see src/db.ts middleware)
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=*
JWT_SECRET=change-me-in-production
STELLAR_NETWORK=public
HORIZON_URL=https://horizon.stellar.org
FEE_CACHE_TTL=30
#health
# Bounded retries for read-only Horizon calls (e.g. fee stats). Submission
# is never transparently retried; these bound only safe reads that failed
# with a transient timeout, connection reset, or 5xx.
HORIZON_READ_RETRY_MAX_ATTEMPTS=3
HORIZON_READ_RETRY_INITIAL_DELAY_MS=250
HORIZON_READ_RETRY_MAX_DELAY_MS=2000
MAX_FEE_STROOPS=1000
DEFAULT_FEE_STROOPS=100

# Rate limiting — see README.md#rate-limiting for details.
RATE_LIMIT_STORE=memory
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_CHALLENGE_MAX=10
RATE_LIMIT_AUTH_CHALLENGE_WINDOW_MS=60000
RATE_LIMIT_AUTH_VERIFY_MAX=10
RATE_LIMIT_AUTH_VERIFY_WINDOW_MS=60000
RATE_LIMIT_SETTLEMENT_CREATE_MAX=20
RATE_LIMIT_SETTLEMENT_CREATE_WINDOW_MS=60000
RATE_LIMIT_SETTLEMENT_CONFIRM_MAX=20
RATE_LIMIT_SETTLEMENT_CONFIRM_WINDOW_MS=60000
# Its own bucket rather than sharing the confirm budget: execution is the
# endpoint clients retry after a network timeout, so its limit has to absorb
# legitimate retries.
RATE_LIMIT_SETTLEMENT_EXECUTE_MAX=20
RATE_LIMIT_SETTLEMENT_EXECUTE_WINDOW_MS=60000
RATE_LIMIT_TREASURY_SUBMIT_MAX=30
RATE_LIMIT_TREASURY_SUBMIT_WINDOW_MS=60000
RATE_LIMIT_ANCHOR_INIT_MAX=10
RATE_LIMIT_ANCHOR_INIT_WINDOW_MS=60000
RATE_LIMIT_ANCHOR_POLL_MAX=60
RATE_LIMIT_ANCHOR_POLL_WINDOW_MS=60000
RATE_LIMIT_ANCHOR_WEBHOOK_MAX=60
RATE_LIMIT_ANCHOR_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_GROUP=30
RATE_LIMIT_HISTORY=60

# Inbound SEP-24 anchor callbacks (POST /api/webhooks/sep24).
#
# Callbacks are authenticated by an HMAC-SHA256 signature over the raw request
# body, keyed by the anchor's shared secret. ANCHOR_WEBHOOK_SECRET is the
# default for single-anchor deployments; SEP24_WEBHOOK_SECRETS overrides it per
# anchor as "anchorName:secret,anchorName:secret" so one compromised credential
# cannot forge updates attributed to another anchor.
SEP24_WEBHOOK_SECRETS=
# How far an anchor's signing timestamp may sit from the server clock before
# the callback is treated as a replay. Only enforced when the anchor sends an
# x-sep24-timestamp header.
SEP24_WEBHOOK_TOLERANCE_MS=300000

# Idempotency for POST /api/settlements/execute — see
# src/plugins/idempotency.ts. A completed reservation replays its stored status
# and body for this long, after which the key may be reused and the row is
# swept. An in-progress reservation answers concurrent retries with 409 until
# it ages past the abandonment window, at which point a crashed process's
# reservation may be re-claimed.
IDEMPOTENCY_TTL_MS=86400000
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_MS=60000

# Background worker — see src/worker/index.ts.
WORKER_INTERVAL_MS=30000
# How long a worker's claim on a settlement or anchor job survives. A crashed
# process's jobs become eligible again once the lease lapses.
WORKER_LEASE_TIMEOUT_MS=60000
WORKER_BATCH_SIZE=50

# Bounded retry policy for *safe* Horizon and anchor reads — see
# src/services/retry.ts, which documents which calls may use it. Payment
# submission and other state-changing calls are never retried: Horizon may have
# applied a transaction and lost the response, so a retry would be a duplicate.
#
# Deliberately conservative. Three attempts bound the worst case at roughly
# three per-call timeouts plus backoff, which keeps a request failing
# predictably during an upstream outage rather than stalling behind it.
UPSTREAM_RETRY_MAX_ATTEMPTS=3
UPSTREAM_RETRY_INITIAL_DELAY_MS=200
UPSTREAM_RETRY_MAX_DELAY_MS=2000
# Fraction of each backoff delay removed as jitter. Without it, identical
# schedules across instances reconverge into synchronized bursts against an
# upstream that is already struggling.
UPSTREAM_RETRY_JITTER_RATIO=0.25

# Bounded retry policy for worker jobs (see src/services/job-retry.ts).
# Settlement submission and anchor polling have separate budgets.
# Total attempts per job, including the first.
WORKER_SETTLEMENT_MAX_ATTEMPTS=3
# Base delay before the first retry (ms); doubles each attempt up to the cap.
WORKER_SETTLEMENT_RETRY_INITIAL_DELAY_MS=1000
WORKER_SETTLEMENT_RETRY_MAX_DELAY_MS=30000
# Fraction of the delay applied as random jitter (0–1).
WORKER_SETTLEMENT_RETRY_JITTER_RATIO=0.25
WORKER_ANCHOR_MAX_ATTEMPTS=5
WORKER_ANCHOR_RETRY_INITIAL_DELAY_MS=5000
WORKER_ANCHOR_RETRY_MAX_DELAY_MS=120000
WORKER_ANCHOR_RETRY_JITTER_RATIO=0.25
