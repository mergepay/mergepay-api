DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mergepay
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=*
JWT_SECRET=change-me-in-production
STELLAR_NETWORK=public
HORIZON_URL=https://horizon.stellar.org
FEE_CACHE_TTL=30
MAX_FEE_STROOPS=1000
DEFAULT_FEE_STROOPS=100

# Rate limiting — see README.md#rate-limiting for details.
RATE_LIMIT_STORE=memory
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_CHALLENGE_MAX=20
RATE_LIMIT_AUTH_CHALLENGE_WINDOW_MS=60000
RATE_LIMIT_AUTH_VERIFY_MAX=10
RATE_LIMIT_AUTH_VERIFY_WINDOW_MS=60000
RATE_LIMIT_SETTLEMENT_CREATE_MAX=20
RATE_LIMIT_SETTLEMENT_CREATE_WINDOW_MS=60000
RATE_LIMIT_SETTLEMENT_CONFIRM_MAX=30
RATE_LIMIT_SETTLEMENT_CONFIRM_WINDOW_MS=60000
RATE_LIMIT_TREASURY_SUBMIT_MAX=30
RATE_LIMIT_TREASURY_SUBMIT_WINDOW_MS=60000
RATE_LIMIT_ANCHOR_INIT_MAX=10
RATE_LIMIT_ANCHOR_INIT_WINDOW_MS=60000
RATE_LIMIT_ANCHOR_POLL_MAX=60
RATE_LIMIT_ANCHOR_POLL_WINDOW_MS=60000
RATE_LIMIT_ANCHOR_WEBHOOK_MAX=60
RATE_LIMIT_ANCHOR_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_GROUP=30
RATE_LIMIT_HISTORY=60

# Inbound SEP-24 anchor callbacks (POST /api/webhooks/sep24).
#
# Callbacks are authenticated by an HMAC-SHA256 signature over the raw request
# body, keyed by the anchor's shared secret. ANCHOR_WEBHOOK_SECRET is the
# default for single-anchor deployments; SEP24_WEBHOOK_SECRETS overrides it per
# anchor as "anchorName:secret,anchorName:secret" so one compromised credential
# cannot forge updates attributed to another anchor.
SEP24_WEBHOOK_SECRETS=
# How far an anchor's signing timestamp may sit from the server clock before
# the callback is treated as a replay. Only enforced when the anchor sends an
# x-sep24-timestamp header.
SEP24_WEBHOOK_TOLERANCE_MS=300000

# Background worker — see src/worker/index.ts.
WORKER_INTERVAL_MS=30000
# How long a worker's claim on a settlement or anchor job survives. A crashed
# process's jobs become eligible again once the lease lapses.
WORKER_LEASE_TIMEOUT_MS=60000
WORKER_BATCH_SIZE=50
