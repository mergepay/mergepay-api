generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  stellarPublicKey String   @unique @map("stellar_public_key")
  displayName      String   @map("display_name")
  avatarUrl        String?  @map("avatar_url")
  createdAt        DateTime @default(now()) @map("created_at")

  memberships      GroupMember[]
  createdGroups    Group[]              @relation("GroupCreator")
  paidExpenses     Expense[]            @relation("ExpensePayer")
  shares           ExpenseShare[]
  settlementsFrom  Settlement[]         @relation("SettlementFrom")
  settlementsTo    Settlement[]         @relation("SettlementTo")
  treasuryTxs      TreasuryTransaction[]
  invites          Invite[]
  anchorSessions   AnchorSession[]
  withdrawals      Withdrawal[]
  proposals        TreasuryProposal[]   @relation("ProposalCreator")
  approvals        TreasuryApproval[]
  auditLogs        AuditLog[]
  idempotencyKeys  IdempotencyKey[]

  @@map("users")
}

model Group {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  createdByUserId         String   @map("created_by_user_id")
  treasuryEnabled         Boolean  @default(false) @map("treasury_enabled")
  treasuryAccountPublicKey String? @map("treasury_account_public_key")
  treasuryRequiredSigners Int?     @map("treasury_required_signers")
  archived                Boolean  @default(false)
  createdAt               DateTime @default(now()) @map("created_at")

  createdBy   User                  @relation("GroupCreator", fields: [createdByUserId], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  treasuryTxs TreasuryTransaction[]
  proposals   TreasuryProposal[]
  invites     Invite[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@index([createdByUserId])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
  @@map("group_members")
}

model Expense {
  id          String   @id @default(cuid())
  groupId     String   @map("group_id")
  payerUserId String   @map("payer_user_id")
  title       String
  description String?
  amount      Decimal  @db.Decimal(20, 7)
  assetCode   String   @map("asset_code")
  assetIssuer String?  @map("asset_issuer")
  splitType   String   @map("split_type")
  memo        String?
  receiptUrl  String?  @map("receipt_url")
  createdAt   DateTime @default(now()) @map("created_at")

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer  User           @relation("ExpensePayer", fields: [payerUserId], references: [id])
  shares ExpenseShare[]

  @@index([groupId])
  @@index([payerUserId])
  @@map("expenses")
}

model ExpenseShare {
  id          String  @id @default(cuid())
  expenseId   String  @map("expense_id")
  userId      String  @map("user_id")
  shareAmount Decimal @db.Decimal(20, 7) @map("share_amount")
  status      String  @default("pending")

  expense     Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  settlements Settlement[]

  @@index([expenseId])
  @@index([userId])
  @@map("expense_shares")
}

model Settlement {
  id             String    @id @default(cuid())
  shortCode      String    @unique @map("short_code")
  groupId        String    @map("group_id")
  fromUserId     String    @map("from_user_id")
  toUserId       String    @map("to_user_id")
  amount         Decimal   @db.Decimal(20, 7)
  assetCode      String    @map("asset_code")
  assetIssuer    String?   @map("asset_issuer")
  stellarTxHash  String?   @map("stellar_tx_hash")
  transactionXdr String?   @map("transaction_xdr")
  status         String    @default("pending")
  // Durable job state for the settlement worker (see src/worker/index.ts).
  // `retryCount` is the number of submission attempts already made;
  // `nextAttemptAt` gates when the row becomes eligible again after a backoff;
  // `errorCategory` records why the last attempt failed ("transient",
  // "indeterminate", "permanent") so operators can tell a stuck job from a
  // dead one. The lease columns are what stop two workers processing the same
  // transition: a claim is only granted when no live lease exists.
  retryCount     Int       @default(0) @map("retry_count")
  nextAttemptAt  DateTime? @map("next_attempt_at")
  errorCategory  String?   @map("error_category")
  claimedBy      String?   @map("claimed_by")
  claimedAt      DateTime? @map("claimed_at")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  failureReason  String?   @map("failure_reason")
  // Server-controlled expiry for the unsigned intent (nullable: rows created
  // before expiration tracking existed have no recorded deadline).
  expiresAt      DateTime? @map("expires_at")
  submittedAt    DateTime? @map("submitted_at")
  confirmedAt    DateTime? @map("confirmed_at")
  memo           String?
  expenseId      String?   @map("expense_id")
  expenseShareId String?   @map("expense_share_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from         User          @relation("SettlementFrom", fields: [fromUserId], references: [id])
  to           User          @relation("SettlementTo", fields: [toUserId], references: [id])
  expenseShare ExpenseShare? @relation(fields: [expenseShareId], references: [id])

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@index([status, updatedAt]) // For worker reconciliation queries
  @@index([status, nextAttemptAt]) // For picking up eligible worker jobs
  @@index([leaseExpiresAt]) // For recovering leases from crashed workers
  @@index([expiresAt])
  @@map("settlements")
}

model TreasuryTransaction {
  id            String   @id @default(cuid())
  shortCode     String   @unique @map("short_code")
  groupId       String   @map("group_id")
  userId        String?  @map("user_id")
  direction     String
  amount        Decimal  @db.Decimal(20, 7)
  assetCode     String   @map("asset_code")
  assetIssuer   String?  @map("asset_issuer")
  destination   String?
  stellarTxHash String?  @map("stellar_tx_hash")
  status        String   @default("pending")
  memo          String?
  /// Hash of the unsigned transaction envelope built at intent creation time.
  /// The confirm endpoint validates the submitted signed XDR against this hash
  /// to ensure the approval is bound to the exact intended transaction.
  intendedTxHash String? @map("intended_tx_hash")
  // Server-controlled signing deadline for the unsigned XDR — same contract as
  // Settlement.expiresAt. See src/lib/time-bounds.ts.
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([groupId])
  @@index([status])
  @@index([expiresAt])
  @@map("treasury_transactions")
}

model Invite {
  id              String    @id @default(cuid())
  groupId         String    @map("group_id")
  code            String    @unique
  expiresAt       DateTime? @map("expires_at")
  createdByUserId String    @map("created_by_user_id")
  maxUses         Int?      @map("max_uses")
  uses            Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdByUserId], references: [id])

  @@index([groupId])
  @@map("invites")
}

model Invitation {
  id               String   @id @default(cuid())
  groupId          String   @map("group_id")
  inviteePublicKey String   @map("invitee_public_key")
  status           String   @default("PENDING")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteePublicKey, status])
  @@index([groupId])
  @@map("invitations")
}

model AnchorSession {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  anchorName            String   @map("anchor_name")
  kind                  String
  assetCode             String   @map("asset_code")
  interactiveUrl        String?  @map("interactive_url")
  externalTransactionId String?  @map("external_transaction_id")
  anchorToken           String?  @map("anchor_token")
  status                String   @default("incomplete")
  failureReason         String?  @map("failure_reason")
  errorCategory         String?  @map("error_category")
  retryCount            Int      @default(0) @map("retry_count")
  lastPolledAt          DateTime? @map("last_polled_at")
  claimedAt             DateTime? @map("claimed_at")
  claimedBy             String?  @map("claimed_by")
  leaseExpiresAt        DateTime?  @map("lease_expires_at")
  // Same durable job-state contract as Settlement: when the session becomes
  // eligible again, and why the last poll failed. See src/worker/index.ts.
  nextAttemptAt         DateTime?  @map("next_attempt_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")
  jobAttemptCount       Int      @default(0) @map("job_attempt_count")
  jobClaimedAt          DateTime? @map("job_claimed_at")
  jobEligibleAt         DateTime @default(now()) @map("job_eligible_at")
  jobErrorSummary       String?  @map("job_error_summary")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([externalTransactionId])
  @@index([status])
  @@index([anchorToken, externalTransactionId]) // For worker polling queries
  @@index([status, lastPolledAt]) // For worker polling with time-based filtering
  @@map("anchor_sessions")
}

/// SEP-24 fiat off-ramp request. Augments the existing
/// `AnchorSession`-based 2-step flow with a simpler, user-facing
/// numeric record that the frontend polls. See Issue #40.
model Withdrawal {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  amount         Decimal  @db.Decimal(20, 7)
  assetCode      String   @map("asset_code")
  assetIssuer    String?  @map("asset_issuer")
  memo           String?
  /// Anchor's external transaction id / SEP-24 `id`, populated on completion.
  anchorTxId     String?  @map("anchor_tx_id")
  /// Interactive URL the user opens to complete KYC / off-ramp.
  interactiveUrl String?  @map("interactive_url")
  status         String   @default("pending")
  failureReason  String?  @map("failure_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([anchorTxId])
  @@map("withdrawals")
}

/// Multisig treasury proposal. Holds an unsigned transaction XDR that
/// group members incrementally sign; once `signatures.length >= threshold`
/// the backend concatenates the signatures and submits to Horizon. See
/// Issue #41.
model TreasuryProposal {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  creatorId  String   @map("creator_id")
  /// Unsigned transaction envelope (XDR). The field is named `xdr` per the
  /// issue spec; values are always pre-signature when this row is created.
  xdr        String   @map("xdr")
  /// Hash of the unsigned XDR, used to bind approvals to this specific
  /// transaction intent. Computed server-side when the proposal is created.
  txHash     String   @map("tx_hash")
  threshold  Int      @default(1)
  /// Array of `{ publicKey, signature }` records explicitly verified by
  /// the backend. Stored as JSON for simplicity (signatures are bounded
  /// by the group threshold, ~few entries per proposal).
  signatures Json     @default("[]")
  status     String   @default("pending")
  stellarTxHash String? @map("stellar_tx_hash")
  failureReason  String? @map("failure_reason")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator   User              @relation("ProposalCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  approvals TreasuryApproval[]

  @@index([groupId])
  @@index([status])
  @@index([creatorId])
  @@map("treasury_proposals")
}

/// Individual signer approval record for a treasury proposal. Each row
/// represents one verified signer's approval of a specific transaction intent.
/// The unique constraint on (proposalId, userId) enforces one approval per
/// signer per proposal at the database level, preventing duplicate approvals
/// even under concurrent requests.
model TreasuryApproval {
  id         String   @id @default(cuid())
  proposalId String   @map("proposal_id")
  userId     String   @map("user_id")
  /// Hash of the unsigned transaction envelope this approval is bound to.
  /// Must match the proposal's txHash — prevents replaying an approval on
  /// a modified transaction.
  txHash     String   @map("tx_hash")
  /// Base64-encoded ed25519 signature.
  signature  String
  signedAt   DateTime @default(now()) @map("signed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  proposal TreasuryProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([proposalId])
  @@index([userId])
  @@map("treasury_approvals")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  // Distinguishes the operation an idempotency key applies to (e.g.
  // "settlement.create" or "settlement.confirm") so the same client-chosen
  // key string can't be replayed across unrelated endpoints.
  scope        String
  key          String
  requestHash  String   @map("request_hash")
  // Lifecycle: "in_progress" while the reserved operation runs, then
  // "completed" (responseJson replays) or "failed" (the key may be retried).
  // See src/services/idempotency.ts.
  status       String   @default("in_progress")
  statusCode   Int?     @map("status_code")
  // Null until the operation completes — a reservation is written before the
  // work runs so the unique constraint serializes concurrent retries.
  responseJson String?  @map("response_json")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  groupId    String?  @map("group_id")
  action     String
  details    Json?
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id])
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([groupId])
  @@map("audit_logs")
}

model StatusHistory {
  id              String   @id @default(cuid())
  entityType      String   @map("entity_type") // "settlement" or "anchor_session"
  entityId        String   @map("entity_id")
  status          String
  reason          String?  // Safe, displayable reason for the status change
  source          String?  // Source of the status change (e.g., "worker", "api", "anchor")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@map("status_history")
}

// Backing store for the optional database-backed rate limiter (see
// src/services/rate-limit-store.ts). Only used when RATE_LIMIT_STORE=database;
// the default in-memory store never touches this table. Rows are
// short-lived counters, not business records — safe to truncate at any time.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rate_limit_buckets")
}

model Sep10Challenge {
  id            String   @id @default(cuid())
  fingerprint   String   @unique
  clientAccount String   @map("client_account")
  expiresAt     DateTime @map("expires_at")
  consumedAt    DateTime @default(now()) @map("consumed_at")

  @@index([expiresAt])
  @@index([consumedAt, expiresAt])
  @@map("sep10_challenges")
}

// Cached Stellar account balances, periodically refreshed from Horizon by
// src/worker/tasks/balance-sync.ts so src/routes/accounts.ts can serve
// balance reads without a live Horizon round-trip on every request.
model AccountBalance {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  assetCode  String   @map("asset_code")
  balance    String
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([accountId, assetCode])
  @@index([accountId])
  @@map("account_balances")
}
